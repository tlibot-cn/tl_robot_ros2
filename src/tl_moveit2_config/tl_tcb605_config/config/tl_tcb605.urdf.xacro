<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tl_tcb605">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tl_tcb605 urdf file -->
    <xacro:include filename="$(find tl_description)/urdf/tcb605.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="tl_tcb605.ros2_control.xacro" />


    <xacro:tl_tcb605_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
