<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tl_tcb705lv">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import tl_tcb705lv urdf file -->
    <xacro:include filename="$(find tl_description)/urdf/tl_tcb705lv.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="tl_tcb705lv.ros2_control.xacro" />


    <xacro:tl_tcb705lv_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
