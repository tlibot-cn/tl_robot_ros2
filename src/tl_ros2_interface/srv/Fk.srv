# 正运动学（关节角 → TCP 位姿）
# 单位遵循 REP 103：joints 为 rad；pose 的 position 为 m、rpy 为 rad。
int32 frame                     # 输出位姿坐标系：1=基坐标 2=工具 3=用户（0=关节，不支持）
float64[] joints                # 关节角，6 或 7 元素（rad；7 元素时第 7 位为外部轴，6 轴补 0）
---
bool success
string message
tl_ros2_interface/CartesianPose pose   # TCP 位姿（position m + rpy rad；arm_angle 为 SDK 第 7 位外部轴角，度→rad）
