# 坐标转换
# 单位遵循 REP 103：关节坐标（coord=0）为 rad；直角/工具/用户坐标（1/2/3）为位置 m + 姿态 rad。
int32 origin_coord        # 源坐标系：0=关节 1=基坐标 2=工具 3=用户
int32 target_coord        # 目标坐标系：0=关节 1=基坐标 2=工具 3=用户
int32 form                # 形态
float64[] origin_pos      # 源坐标（关节：rad；直角/工具/用户：m + rad）
float64[] reference_pos   # 逆解参考关节角（rad）
---
bool success
string message
float64[] target_pos      # 转换结果（关节：rad；直角/工具/用户：m + rad）
