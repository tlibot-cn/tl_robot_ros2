# 获取机械臂状态
int32 channel              # 查询通道（最多 9 个）
bool stop                  # true 时停止持续发送
int32 mode                 # 0=查询一次 1=持续回复
int32 interval             # 持续回复间隔，单位：ms（范围 [10,60000]，仅 mode=1 有效）
bool io_state              # 是否查询 IO
int32 position             # 点位类型：0=关节坐标 1=基坐标
bool detail_motion_pos     # 是否返回运动点位详情
int32 pos_sum              # 每帧返回的点位数量
string[] io_port           # 要查询的 IO 端口列表
string[] optional          # 点位坐标类型："ACS"（关节）/ "MCS"（基坐标）/ "time" / "reset"
---
bool success
string message
