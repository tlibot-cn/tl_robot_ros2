#!/usr/bin/env bash
#
# pre-commit hook — C++ 与 Python 代码格式化
# 自动格式化暂存区中的 C++ 和 Python 文件，并重新暂存
#
# 工具: clang-format (C++) + black (Python)
# 跳过: git commit --no-verify 或 -n
#

set -euo pipefail

readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly NC='\033[0m'

PROJECT_ROOT=$(git rev-parse --show-toplevel)

# ── 通用: 格式化文件列表 ────────────────────────
# 参数: $1=语言标签, $2=文件列表
# 通过文件描述符 3 传入要运行的格式化命令
format_files() {
    local label="$1"
    local files="$2"

    if [ -z "$files" ]; then
        echo -e "${GREEN}[pre-commit] No ${label} files staged, skipping${NC}"
        return 0
    fi

    echo -e "${YELLOW}[pre-commit] Checking ${label} formatting...${NC}"

    local need_formatting=false
    local formatted=""

    while IFS= read -r file; do
        [ ! -f "$file" ] && continue

        # 运行格式化命令（从文件描述符 3 读取）
        # 注意: 这要求外部定义了 format_cmd 函数
        format_cmd "$file" 2>/dev/null || true

        if ! git diff --quiet "$file"; then
            need_formatting=true
            formatted="${formatted}  ${file}\n"
            git add "$file"
        fi
    done <<< "$files"

    if [ "$need_formatting" = true ]; then
        echo -e "${YELLOW}[pre-commit] Auto-formatted ${label}:${NC}"
        echo -e "$formatted"
    else
        echo -e "${GREEN}[pre-commit] All ${label} files are properly formatted${NC}"
    fi
}

# ── 忽略路径（与 scripts/format-cpp.sh 保持一致） ──
IGNORE_PATTERNS=(
    '^src/tl_driver/lib/include/'
    '^src/tl_teleop/lib/include/'
)

# ── 收集暂存区的 C++ 文件（排除忽略路径） ──────
CPP_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.(cpp|h|hpp|cc|cxx)$' \
    | while IFS= read -r f; do
        skip=false
        for pat in "${IGNORE_PATTERNS[@]}"; do
            if [[ "$f" =~ $pat ]]; then
                skip=true
                break
            fi
        done
        $skip || echo "$f"
      done \
    || true)

# ── C++: clang-format ─────────────────────────
CLANG_FORMAT_FILE="${PROJECT_ROOT}/.clang-format"
if [ -n "$CPP_FILES" ]; then
    if [ -f "$CLANG_FORMAT_FILE" ] && command -v clang-format &>/dev/null; then
        format_cmd() { clang-format "$1" > "$1.fmt_tmp" && mv "$1.fmt_tmp" "$1"; }
        format_files "C++" "$CPP_FILES"
    else
        echo -e "${YELLOW}[pre-commit] clang-format or .clang-format not found, skipping C++ check${NC}"
    fi
else
    echo -e "${GREEN}[pre-commit] No C++ files staged, skipping${NC}"
fi

# ── 收集暂存区的 Python 文件 ────────────────────
PY_FILES=$(git diff --cached --name-only --diff-filter=ACM \
    | grep -E '\.py$' \
    || true)

# ── Python: black ──────────────────────────────
if [ -n "$PY_FILES" ]; then
    if command -v black &>/dev/null; then
        format_cmd() { black --quiet "$1"; }
        format_files "Python" "$PY_FILES"
    else
        echo -e "${YELLOW}[pre-commit] black not found, skipping Python check${NC}"
    fi
else
    echo -e "${GREEN}[pre-commit] No Python files staged, skipping${NC}"
fi

exit 0
